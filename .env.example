# GA_Submission: offline replay does not need credentials or a .env file.
# For optional explicitly enabled live tests, copy this file to evidence/.env:
# PowerShell, from GA_Submission: Copy-Item .env.example evidence/.env
# The bundled API clients load evidence/.env. Never commit a populated .env.

# Copy to .env locally. Never commit or print real keys.
GNANI_API_KEY=
GNANI_ASR_MODEL=prisma-v3.0
GNANI_ASR_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
# Voice/language belong in each verified manifest row when they differ.
GNANI_ASR_FORMAT=transcribe
GNANI_TTS_VOICE=Tarika
GNANI_TTS_SAMPLE_RATE=24000
# Set to 1 only in a session that may spend credits.
GNANI_LIVE=0

# Judge model for listening tasks (Google Gemini; separate from Gnani credits)
GEMINI_API_KEY=
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# Required before new paid Gnani speech runs; enter reconciled prior spend.
GNANI_SPENT_TO_DATE_INR=
# Phone test ingress and separate call reservation ledger
CALL_ACCESS_TOKEN=
CALL_SPENT_TO_DATE_INR=
CALL_MAX_SECONDS=300

# Optional: an imported complete Gnani dashboard reading supplies the budget baseline.
# Real-call scenario is passed in the WSS query as scenario=CALL03.
CALL_TTS_MODEL=timbre-v2.5
CALL_TTS_VOICE=Kaveri
CALL_TTS_BUFFER_S=0
CALL_BOT_PORT=7861
